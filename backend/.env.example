# App
APP_ENV=development
APP_SECRET_KEY=changeme-32-random-bytes
CORS_ORIGINS=http://localhost:5173,https://shopthevlog.com

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret-from-supabase-dashboard>

# YouTube / Google
YOUTUBE_CLIENT_ID=<google-oauth-client-id>
YOUTUBE_CLIENT_SECRET=<google-oauth-client-secret>
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/connect/youtube/callback
YOUTUBE_API_KEY=<youtube-data-api-key>

# Instagram
INSTAGRAM_CLIENT_ID=<instagram-app-id>
INSTAGRAM_CLIENT_SECRET=<instagram-app-secret>
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/connect/instagram/callback

# AI
ANTHROPIC_API_KEY=<claude-api-key>
OPENAI_API_KEY=<openai-api-key>

# Duffel
DUFFEL_ACCESS_TOKEN=<duffel-access-token>
DUFFEL_WEBHOOK_SECRET=<duffel-webhook-signing-secret>

# Redis (for ARQ task queue)
REDIS_URL=redis://localhost:6379
