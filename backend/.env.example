# PostgreSQL (Prisma schema — same URL as Next.js .env)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# App
APP_ENV=development
APP_SECRET_KEY=changeme-32-random-bytes
CORS_ORIGINS=http://localhost:3000,https://shopthevlog.com

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (formerly service_role key) — get from Supabase dashboard > API > Secret key
SUPABASE_SECRET_KEY=<secret-key>
# SUPABASE_JWT_SECRET is no longer required — JWT verification uses JWKS (ES256/RS256)

# YouTube / Google
YOUTUBE_CLIENT_ID=<google-oauth-client-id>
YOUTUBE_CLIENT_SECRET=<google-oauth-client-secret>
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/connect/youtube/callback
YOUTUBE_API_KEY=<youtube-data-api-key>

# Instagram
INSTAGRAM_CLIENT_ID=<instagram-app-id>
INSTAGRAM_CLIENT_SECRET=<instagram-app-secret>
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/connect/instagram/callback

# TikTok
TIKTOK_CLIENT_KEY=<tiktok-client-key>
TIKTOK_CLIENT_SECRET=<tiktok-client-secret>
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social/connect/tiktok/callback

# AI
GEMINI_API_KEY=<google-gemini-api-key>

# Google Places (AI pipeline — location resolution)
GOOGLE_PLACES_API_KEY=<google-places-api-key>

# Redis (optional — used by slowapi for rate limiting; falls back to in-memory if unset)
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
